@page
@using Calculator.Contracts
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Calculator.WebRazor.Pages.CalculatorModel
@{
    ViewData["Title"] = "Calculator page";
}
<form method="post">
    <input type="text" name="Value1" value="@Model.Hodnota1" />
    <br />
    
    <label for="OperandDropdown"> Choose operand:</label>
    
    <select name="Operand" id="OperandDropdown">
        <option value="Add" selected="@(Model.Operand == OperationEnum.Add ? "selected" : null)">+</option>
        <option value="Sub" selected="@(Model.Operand == OperationEnum.Sub ? "selected" : null)">−</option>
        <option value="Mult" selected="@(Model.Operand == OperationEnum.Mult ? "selected" : null)">×</option>
        <option value="Div" selected="@(Model.Operand == OperationEnum.Div ? "selected" : null)">÷</option>
    </select>
 
    <br />
    <input type="text" name="Value2" value="@Model.Hodnota2" />
    <br />
    <input type="submit" />
</form>

@Model.Result

